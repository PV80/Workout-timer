{
  "expo": {
    "name": "WorkoutTimer",
    "slug": "workout-timer",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1010",
    "platforms": [
      "android"
    ],
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1010"
    },
    "android": {
      "package": "com.briangitau.workouttimer",
      "permissions": [
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1010"
      },
      "versionCode": 3
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to photograph your handwritten workout tracker page."
        }
      ],
      "./plugins/withCropActivityInsets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "workouttimer"
  }
}
